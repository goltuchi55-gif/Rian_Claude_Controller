# Secrets
.env
.env.*
*.key
*.pem
*.pfx
*.token
secrets/
credentials/

# Runtime JSON / lock / pid
*.pid
*.lock
*.tmp
*.temp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Backup noise
*.bak
*.backup
*~
